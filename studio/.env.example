# Studio build-time configuration (Vite bakes VITE_* vars into the bundle).
#
# Leave VITE_API_BASE_URL unset for the default: the SPA calls the API with
# same-origin relative URLs. That is correct for
#   - local dev (the Vite proxy forwards to the orchestrator on :8001), and
#   - the single-service deploy (FastAPI serves the SPA and API on one origin).
#
# Set it only for a SPLIT deploy where the SPA is hosted separately from the API.
# The API must then list this SPA's origin in its ALLOWED_ORIGINS (CORS).
# VITE_API_BASE_URL=https://your-orchestrator.up.railway.app
